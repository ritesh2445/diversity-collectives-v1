# ==============================================================================
# Diversity Collective Ventura County — Environment Configuration Template
# Copy this file to .env (frontend), worker/.dev.vars (Worker), and studio/.env (Studio)
# NEVER commit sensitive API keys or auth tokens to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Public Configuration (Vite — prefix with VITE_)
# ------------------------------------------------------------------------------
# Base URL for the Cloudflare Worker API backend
# In local dev: http://localhost:8787/api
# In production: https://api.diversitycollective.org/api or https://dcvc-api.<account>.workers.dev/api
VITE_API_URL=https://api.diversitycollective.org/api

# Cloudflare Turnstile Public Site Key (Invisible or Managed mode)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAXXXXXXXXXXXXXX

# Cloudinary Cloud Name for auto-formatted, high-performance responsive media
VITE_CLOUDINARY_CLOUD_NAME=dcvc

# Sanity CMS Public Project ID & Dataset (Read-only public CDN queries)
VITE_SANITY_PROJECT_ID=v7z28m5x
VITE_SANITY_DATASET=production

# Zeffy Non-Profit Donation Portal Form Embed URL (100% free fee model)
VITE_ZEFFY_DONATION_FORM_URL=https://www.zeffy.com/donation-form/diversity-collective-general-fund

# Ask DCVC Free AI Chatbot Feature Flag (Disabled by default until final activation)
VITE_ENABLE_CHATBOT=false

# ------------------------------------------------------------------------------
# 2. Cloudflare Worker Backend Configuration (worker/ - Secrets via wrangler secret)
# ------------------------------------------------------------------------------
# Turso (libSQL) Distributed SQLite Database
# Obtained via: turso db show <database-name> --url
TURSO_DATABASE_URL=libsql://dcvc-directory-<org>.turso.io

# Turso Authentication Token
# Obtained via: turso db tokens create <database-name>
TURSO_AUTH_TOKEN=eyJhbGciOi...

# Resend API Key for Transactional Email Notifications
# Obtained via: https://resend.com/api-keys
RESEND_API_KEY=re_123456789...

# Cloudflare Turnstile Secret Key for Server-Side Form Validation
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Allowed Frontend Origins for Strict CORS Enforcement
ALLOWED_ORIGIN=https://diversitycollective.org

# Staff Inquiries Routing Recipient
DCVC_STAFF_EMAIL=info@diversitycollective.org

# Resend Verified Sending Identity
RESEND_FROM_EMAIL=Diversity Collective <noreply@diversitycollective.org>

# Zeffy Webhook HMAC Signature Secret
# Obtained via Zeffy Dashboard > Settings > Integrations / Webhooks
ZEFFY_WEBHOOK_SECRET=zeffy_whsec_...

# Configurable Appreciation Card Thresholds (USD)
APPRECIATION_TIER_1_MIN=1
APPRECIATION_TIER_2_MIN=50
APPRECIATION_TIER_3_MIN=150
APPRECIATION_TIER_4_MIN=500
FRONTEND_BASE_URL=https://diversitycollective.org

# Ask DCVC Free AI Chatbot Backend Settings
CHATBOT_ENABLED=false
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# ------------------------------------------------------------------------------
# 3. Sanity Studio Workspace Configuration (studio/ - Independent Admin Deployment)
# ------------------------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=v7z28m5x
SANITY_STUDIO_DATASET=production

